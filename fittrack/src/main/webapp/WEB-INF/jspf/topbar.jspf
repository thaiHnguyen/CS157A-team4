
<%--
    topbar.jspf - Shared navigation bar and flash messages.

    Includes:
    - Member navigation
    - Trainer navigation
    - Staff navigation (FR 1.3.4)
    - Flash messages
--%>

<%
    String here = request.getServletPath();
%>

<div class="topbar">
    <div class="wrap">

        <a class="brand" href="<%= ctx %>/index.jsp">
            FitTrack
        </a>

        <nav>

            <% if (userId == null) { %>

                <a href="<%= ctx %>/login.jsp"
                   class="<%= here.equals("/login.jsp") ? "on" : "" %>">
                    Sign in
                </a>

                <a class="btn-quiet"
                   href="<%= ctx %>/register.jsp">
                    Join
                </a>

            <% } else { %>

                <a href="<%= ctx %>/home.jsp"
                   class="<%= here.equals("/home.jsp") ? "on" : "" %>">
                    Dashboard
                </a>

                <a href="<%= ctx %>/schedule.jsp"
                   class="<%= here.equals("/schedule.jsp") ? "on" : "" %>">
                    Schedule
                </a>

                <% if (isMember) { %>

                    <a href="<%= ctx %>/membership.jsp"
                       class="<%= here.equals("/membership.jsp") ? "on" : "" %>">
                        Membership
                    </a>

                    <a href="<%= ctx %>/checkin.jsp"
                       class="<%= here.equals("/checkin.jsp") ? "on" : "" %>">
                        Check in
                    </a>

                <% } %>

                <% if ("TRAINER".equals(role)) { %>

                    <a href="<%= ctx %>/trainer.jsp"
                       class="<%= here.equals("/trainer.jsp") ? "on" : "" %>">
                        My classes
                    </a>

                <% } %>

                <%-- FR 1.3.4: Staff management navigation --%>
                <% if ("STAFF".equals(role)) { %>

                    <a href="<%= ctx %>/staff-classes.jsp"
                       class="<%= here.equals("/staff-classes.jsp") ? "on" : "" %>">
                        Manage Classes
                    </a>

                <% } %>

                <a href="<%= ctx %>/profile.jsp"
                   class="<%= here.equals("/profile.jsp") ? "on" : "" %>">
                    Profile
                </a>

                <span class="who">
                    <strong><%= esc(fullName) %></strong>

                    <% if (role != null && !role.isEmpty()) { %>
                        (<%= esc(
                            role.substring(0, 1).toUpperCase()
                            + role.substring(1).toLowerCase()
                        ) %>)
                    <% } %>
                </span>

                <a class="btn-quiet"
                   href="<%= ctx %>/logout.jsp">
                    Log out
                </a>

            <% } %>

        </nav>
    </div>
</div>

<%--
    Flash messages are displayed here for regular pages.
    staff-classes.jsp handles its own flash messages,
    so exclude that page to prevent duplicates.
--%>

<% if (flashText != null
       && !"/staff-classes.jsp".equals(here)) { %>

    <div class="wrap">
        <p class="<%= flashOk ? "success" : "error" %> flash">
            <%= esc(flashText) %>
        </p>
    </div>

<% } %>
